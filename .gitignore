# Root level gitignore

# Dependency directories
node_modules/

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# OS files
Thumbs.db
Desktop.ini

# Stray lock files
package-lock.json
