# Backend gitignore

# Environment variables - NEVER push this
.env
.env.local
.env.*.local

# Dependency directory
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Debug/test files
testdns.js

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
