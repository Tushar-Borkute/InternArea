.vscode/*
!.vscode/extensions.json
.idea
.idea/
.DS_Store

# OS files
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Stray lock files at root
package-lock.json
